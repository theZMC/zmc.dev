---
import { toRoman } from "@lib/utils/roman";

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  links?: FooterLink[];
  /** the current page's QR-page href; null suppresses the link */
  qrHref?: string | null;
}

const {
  links = [
    { label: "GitHub", href: "https://github.com/theZMC" },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/thezmc/" },
    { label: "Writing", href: "/posts" },
    { label: "Resume", href: "/resume" },
    { label: "RSS", href: "/rss.xml" },
  ],
  qrHref,
} = Astro.props;

// the QR beacon trails every list — a page-scoped link after the site-wide ones
const allLinks = qrHref ? [...links, { label: "QR", href: qrHref }] : links;

const year = toRoman(new Date().getFullYear());
---

<footer>
  <div class="foot-inner">
    <span class="mono">© {year} Zach Callahan · zmc.dev</span>
    <div class="links mono">
      {
        allLinks.map((link) => (
          <a
            href={link.href}
            {...(/^https?:\/\//.test(link.href)
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
